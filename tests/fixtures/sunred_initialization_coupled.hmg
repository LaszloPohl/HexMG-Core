HEXMG 1.0
.RAILS=3 R0=0 R1=20 R2=25
.FUNCTION ETC0 P=4 V=3
_SUBC RET P0 25
_MULC RET RET 0.02
_ADDC RET RET 1
_INV RET RET
_MULC RET RET 1
_ADDC V2 RET 0
_SUB V0 P2 P1
_MUL RET RET V0
_MUL RET RET P3
.END FUNCTION ETC0
.FUNCTION THRAD P=3 V=4
_ADDC V0 P0 273.15
_ADDC V1 P1 273.15
_ADD V2 V0 V1
_MUL V0 V0 V0
_MUL V1 V1 V1
_ADD V3 V0 V1
_SUB RET P1 P0
_MUL RET RET P2
_MUL RET RET V2
_MUL RET RET V3
.END FUNCTION THRAD
.SUNREDTREE COUPLEDTREE
RED 1 0 0 14 0 15
RED 1 1 0 12 0 13
RED 2 0 1 1 1 0
RED 1 2 0 10 0 11
RED 1 3 0 8 0 9
RED 2 1 1 3 1 2
RED 3 0 2 1 2 0
RED 1 4 0 6 0 7
RED 1 5 0 4 0 5
RED 2 2 1 5 1 4
RED 1 6 0 2 0 3
RED 1 7 0 0 0 1
RED 2 3 1 7 1 6
RED 3 1 2 3 2 2
RED 4 0 3 1 3 0
.END SUNREDTREE COUPLEDTREE
.MODEL COUPLED SUBCIRCUIT N=5 SUNRED=COUPLEDTREE
.DEFAULTRAILRANGE R2 N0 N0
.DEFAULTRAILRANGE R2 N4 N4
I0 I N0 R0 DC0=0.5 DC=0.5
TC0 I N0 R0 DC0=0 DC=0
EC0 I N1 R0 DC0=0 DC=0
TC0F0 I N0 R0 DC0=0 DC=0
EC0F0 I N1 R0 DC0=0 DC=0
TC0F1 I N0 R0 DC0=0 DC=0
EC0F1 I N1 R0 DC0=0 DC=0
TC0F2 I N0 R0 DC0=0 DC=0
EC0F2 FCIMD P=1 F=ETC0(X3 X0 X1 P2) N1 R1 N2 N0 N0 1 0 2
TC0F3 I N0 R0 DC0=0 DC=0
EC0F3 FCIMD P=1 F=ETC0(X3 X0 X1 P2) N1 R0 N3 N0 N0 1 0 2
QR11 FCI P=1 F=THRAD(X0 X1 P1) N4 R2 0 5.8971893957600005e-08
TC0F4 G N0 N4 20
EC0F4 I N1 R0 DC0=0 DC=0
TC0F5 I N0 R0 DC0=0 DC=0
EC0F5 I N1 R0 DC0=0 DC=0
.END MODEL COUPLED
.OPTIONAL HEXMG_OPT 1
CONVERGENCE RELATIVE 0 1e-10 9.9999999999999998e-13
MAX_ITERATIONS 100
CONVERGENCE_NODE circuit CELL.N0 25 1e-10 9.9999999999999998e-13
CONVERGENCE_NODE circuit CELL.N4 25 1e-10 9.9999999999999998e-13
FUNCTION_GUARD ETC0 P0 V2 -273.14999999999998 *
FUNCTION_RANGE THRAD P0 -273.15 *
FUNCTION_RANGE THRAD P1 -273.15 *
FUNCTION_RANGE THRAD RET * *
.END OPTIONAL
.MODEL ROOT SUBCIRCUIT
CELL MODEL COUPLED
.END MODEL ROOT
.CREATE circuit ROOT GND=R0
.PROBE IMAGE HXIM DEF DOUBLE V 00112233445546778899AABBCCDDEEFF F47AC10B58CC4372A5670E02B2C3D479 circuit
.PROBE IMAGE HXIM NODES circuit CELL.N0 CELL.N4 CELL.N3
.RUN circuit DC INITIAL ERR=1e-11
.SAVE HXIM FILE="result.hxim" IMAGE
